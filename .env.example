# tawk.to live chat
# Copy these values from the existing Yunnan Unfolded tawk.to embed code.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Public Cloudflare Worker endpoint, including /enquiries
